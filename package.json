{
  "name": "cadpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/viewer"
  ],
  "scripts": {
    "dev": "npm run dev -w @cadpad/desktop",
    "build": "npm run build -w @cadpad/desktop",
    "desktop": "cargo build --locked -p cadpad-core -p cadpad-mcp --bins && npm run tauri -w @cadpad/desktop -- dev",
    "test:viewer": "node --experimental-strip-types --test packages/viewer/tests/*.test.ts",
    "bench:reference": "node --experimental-strip-types scripts/check_reference_picking.ts",
    "bench:render-buffers": "node scripts/check_render_buffers.mjs",
    "bench:revision-buffers": "node --experimental-strip-types scripts/check_revision_buffers.ts",
    "test:ui": "node --test apps/desktop/tests/*.test.mjs",
    "test:notices": "node --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  }
}
