              "unit": "mm"
            }
          }
        }
      }
    },
    {
      "id": "c3",
      "rule": "aligned",
      "span": [
        77,
        114
      ],
      "args": {
        "a": {
          "part": {
            "model": {
              "entry": "device.py",
              "builder": "device"
            },
            "part": {
              "name": "pcb/J1"
            }
          }
        },
        "b": {
          "feature": {
            "kind": "explicit",
            "part": {
              "model": {
                "entry": "device.py",
                "builder": "device"
              },
              "part": {
                "name": "case"
              }
            },
            "name": "usb_cutout"
          }
        },
        "tol": {
          "quantity": {
            "value": 0.2,
            "unit": "mm",
            "source": "inferred",
            "note": "no tolerance stated"
          }
        },
        "margin": {
          "quantity": {
            "value": 0.3,
            "unit": "mm",
            "source": "inferred",
            "note": "no margin stated"
          }
        }
